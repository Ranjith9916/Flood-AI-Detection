# =============================================================
# FLOOD AI EARLY WARNING SYSTEM - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# =============================================================

# ---- Application ----
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ---- Database ----
# For Docker (use service name "postgres"):  postgresql+psycopg://flood_admin:flood_password@postgres:5432/flood_ai
# For local development:                    postgresql+psycopg://flood_admin:flood_password@localhost:5432/flood_ai
DATABASE_URL=postgresql+psycopg://flood_admin:flood_password@localhost:5432/flood_ai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Redis ----
# For Docker: redis://redis:6379/0
# For local:  redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_WEATHER=300
REDIS_TTL_RAINFALL=300
REDIS_TTL_PREDICTIONS=600
REDIS_TTL_ALERTS=60

# ---- Security / CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Leave empty to disable API key authentication (development mode)
API_KEY=

# ---- Study Area ----
# Format: lon_min,lat_min,lon_max,lat_max
# Default: Bangalore metropolitan region
STUDY_AREA_BBOX=77.35,12.75,77.85,13.20

# ---- Open-Meteo (free, no auth required) ----
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_TIMEOUT_S=30

# ---- NASA Earthdata (for GPM IMERG satellite data) ----
# Register at: https://urs.earthdata.nasa.gov/
# Required for satellite precipitation ingestion
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# ---- GFS NWP (NOAA NOMADS - public) ----
GFS_BASE_URL=https://nomads.ncep.noaa.gov/dods

# ---- Weather Radar ----
# Configure per deployment / data provider
RADAR_BASE_URL=
RADAR_API_KEY=

# ---- Rainfall Thresholds (IMD classification, mm/day) ----
# Adjust per region / national meteorological standard
RAINFALL_LIGHT_THRESHOLD_MM=2.5
RAINFALL_MODERATE_THRESHOLD_MM=15.6
RAINFALL_HEAVY_THRESHOLD_MM=64.5
RAINFALL_VERY_HEAVY_THRESHOLD_MM=115.5
RAINFALL_EXTREMELY_HEAVY_THRESHOLD_MM=204.5

# ---- Flood / Risk Thresholds (flood probability 0-1) ----
FLOOD_PROB_MODERATE_THRESHOLD=0.35
FLOOD_PROB_HIGH_THRESHOLD=0.55
FLOOD_PROB_VERY_HIGH_THRESHOLD=0.70
FLOOD_PROB_EXTREME_THRESHOLD=0.85

# ---- Pipeline Schedules (cron expressions) ----
PIPELINE_WEATHER_CRON=0 * * * *
PIPELINE_RAINFALL_CRON=0 * * * *
PIPELINE_SATELLITE_CRON=0 */3 * * *
PIPELINE_NWP_CRON=0 */6 * * *
PIPELINE_PREDICTIONS_CRON=15 * * * *

# ---- MLflow ----
# For Docker: http://mlflow:5000
# For local:  http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Data and Model Directories ----
ML_MODELS_DIR=ml/models
ML_DATA_DIR=ml/data
ML_FEATURES_DIR=ml/data/features
DATA_RAW_DIR=ml/data/raw
DATA_PROCESSED_DIR=ml/data/processed
GEOSPATIAL_DIR=geospatial
OUTPUTS_DIR=outputs

# ---- Forecast Horizons (hours, comma-separated) ----
FORECAST_HORIZONS_H=1,3,6,12,24
